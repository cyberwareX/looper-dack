# Copy to .env and fill in. Never commit real values (.env is gitignored).

# Alchemy Base-mainnet RPC key — used by looper_fetch.py / compose_soul.py to read a
# Looper's on-chain tokenURI. Get one at https://alchemy.com (Base mainnet app).
ALCHEMY_KEY=your-alchemy-base-mainnet-key

# The base soul the composer extends (prompts/stimuli/memory). Clone the public template
#   git clone https://github.com/obraztsov/dack-soul.git
# and point this at your copy. If unset, compose_soul.py falls back to a sibling
# dack-engine checkout's soul-template/ (../dack-engine/soul-template).
SOUL_TEMPLATE=/path/to/dack-soul

# Your pond's Buzz (Nostr) relay, baked into the ingress config + buzz-cli env at compose
# time. Only needed if you wire the Buzz channel; leave as-is otherwise.
BUZZ_RELAY=https://your-buzz-relay.example
